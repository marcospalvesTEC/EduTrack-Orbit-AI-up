# ==============================================================================
# EduTrack Orbit AI - Configurações de Ambiente Local (.env.example)
# Copie este arquivo para .env e preencha com valores de desenvolvimento.
# NUNCA insira credenciais ou tokens reais de produção neste arquivo.
# ==============================================================================

# Ambiente de execução: development, staging, production
ENVIRONMENT=development

# Configurações do Backend Xano (URL base da API de desenvolvimento)
# Substitua pelo endereço da SUA instância. Nunca commite a URL real:
# o repositório é público e o AGENTS.md proíbe expor URLs privadas do Xano.
# Formato: https://<instancia>.n7.xano.io/api:<branch>
XANO_API_BASE_URL=https://sua-instancia.n7.xano.io/api:sua_branch

# Chave de API pública / Token de teste (opcional em dev local)
# Nunca use um token real neste arquivo.
XANO_API_KEY=mock_dev_api_key_12345

# Configurações de Internacionalização
DEFAULT_LANGUAGE=pt-BR
