# ==============================================================================
# EduTrack Orbit AI - Streamlit Secrets Example (.streamlit/secrets.toml.example)
# Modelo seguro de configuração de segredos para Streamlit Cloud / Produção.
# Copie para .streamlit/secrets.toml no ambiente local ou configure no Cloud.
# ==============================================================================
# NÃO comite o arquivo real (.streamlit/secrets.toml). Ele está no .gitignore.
# Substitua o placeholder abaixo pela URL da SUA instância. O repositório é
# público e o AGENTS.md proíbe expor URLs privadas do Xano.
# Formato: https://<instancia>.n7.xano.io/api:<branch>

environment = "development"
xano_api_base_url = "https://sua-instancia.n7.xano.io/api:sua_branch"
default_language = "pt-BR"
